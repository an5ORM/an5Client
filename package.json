{
  "name": "an5-client",
  "version": "0.1.0",
  "description": "Generated client artifacts for AN5 ORM - TypeScript types, Python models, .NET entities, and Go structs.",
  "license": "MIT",
  "main": "typescript/index.js",
  "types": "typescript/index.d.ts",
  "exports": {
    ".": "./typescript/index.js",
    "./typescript": "./typescript/index.js",
    "./typescript/*": "./typescript/*",
    "./python": "./python/an5_metadata.py",
    "./dotnet": "./dotnet",
    "./golang": "./golang"
  },
  "author": "an5ORM",
  "homepage": "https://github.com/an5ORM/an5",
  "repository": {
    "type": "git",
    "url": "https://github.com/an5ORM/an5Client.git"
  },
  "keywords": ["an5", "client", "orm", "typescript", "python", "dotnet", "go", "golang"],
  "files": [
    "typescript/*.{ts,js,d.ts}",
    "python/**/*.py",
    "dotnet/**/*",
    "golang/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node test/smoke.test.js",
    "test:package:smoke": "node test/package-smoke.js",
    "test:python": "(python -m compileall python 2>&1 || python3 -m compileall python 2>&1)",
    "test:dotnet": "node test/dotnet-compile-check.js",
    "test:go": "cd golang && go test ./..."
  },
  "dependencies": {
    "@an5/orm": "^1.0.8"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
