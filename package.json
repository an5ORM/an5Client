{
  "name": "an5-client",
  "version": "0.1.4",
  "description": "Generated client artifacts for AN5 ORM - TypeScript types, Python models, .NET entities, Go structs, and Rust, Java, Kotlin, and Swift crate.",
  "license": "MIT",
  "main": "typescript/index.js",
  "types": "typescript/index.d.ts",
  "exports": {
    ".": "./typescript/index.js",
    "./typescript": "./typescript/index.js",
    "./typescript/*": "./typescript/*",
    "./python": "./python/an5_metadata.py",
    "./dotnet": "./dotnet",
    "./golang": "./golang",
    "./rust": "./rust/Cargo.toml",
    "./java": "./java",
    "./kotlin": "./kotlin",
    "./swift": "./swift/Package.swift"
  },
  "author": "an5ORM",
  "homepage": "https://github.com/an5ORM/an5",
  "repository": {
    "type": "git",
    "url": "https://github.com/an5ORM/an5Client.git"
  },
  "keywords": [
    "an5",
    "client",
    "orm",
    "typescript",
    "python",
    "dotnet",
    "go",
    "golang",
    "rust",
    "java",
    "kotlin",
    "swift"
  ],
  "files": [
    "typescript/*.{ts,js,d.ts}",
    "python/**/*.py",
    "dotnet/**/*",
    "golang/**/*",
    "rust/Cargo.toml",
    "rust/src/**/*",
    "java/**/*.java",
    "kotlin/**/*.kt",
    "swift/Package.swift",
    "swift/Sources/An5Client/*.swift",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node test/smoke.test.js",
    "test:package:smoke": "node test/package-smoke.js",
    "test:python": "node test/python-tests.js",
    "test:dotnet": "node test/dotnet-compile-check.js && node test/dotnet-sqlite-smoke.js",
    "test:go": "cd golang && go test ./... && cd ../test/golang-runtime && go test -mod=mod ./...",
    "test:rust": "node test/rust-compile-check.js",
    "test:java": "node test/client-compile-check.js"
  },
  "dependencies": {
    "@an5/orm": "^1.0.8"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
