{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": "./typescript",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["typescript/*.ts"],
  "exclude": ["node_modules", "dist", "python", "dotnet", "typescript/src"]
}
